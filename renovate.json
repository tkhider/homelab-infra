{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "flux": {
    "managerFilePatterns": ["/(^|/)helm-(release|repositor(y|ies))\\.yaml$/"]
  },
  "packageRules": [
    {
      "description": "kube-prometheus-stack cuts releases many times a week; only PR major versions",
      "matchDepNames": ["kube-prometheus-stack"],
      "matchUpdateTypes": ["minor", "patch"],
      "enabled": false
    },
    {
      "matchPackageNames": ["jellyfin/jellyfin"],
      "versioning": "semver-coerced"
    }
  ]
}
