{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "flux": {
    "managerFilePatterns": ["/(^|/)helm-(release|repositor(y|ies))\\.yaml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)helm-release\\.yaml$/"
      ],
      "matchStrings": [
        "repository:\\s*(?<depName>[^\\s]+)\\s*\\n\\s*tag:\\s*[\"']?(?<currentValue>[^\\s\"']+)[\"']?"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "kube-prometheus-stack cuts releases many times a week; only PR major versions",
      "matchPackageNames": ["kube-prometheus-stack"],
      "matchUpdateTypes": ["minor", "patch"],
      "enabled": false
    }
  ]
}
